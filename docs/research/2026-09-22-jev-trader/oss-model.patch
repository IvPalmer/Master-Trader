-export const createModel = (): Model => (config.model === "jev" ? new JevModel() : new MockModel());
+/**
+ * Open-source stand-in for Jev, OpenJev-style: an open-weight LLM reads the SAME state and the SAME
+ * question/criteria that JevModel sends, and the buy/sell probability comes from the log-likelihood of
+ * the two candidate answers (one forward pass, one output token). Served locally by ollama.
+ */
+export class OssModel implements Model {
+  readonly name = `oss:${process.env.OSS_MODEL ?? "qwen3:4b-instruct"}`;
+  private url = (process.env.OLLAMA_URL ?? "http://127.0.0.1:11434") + "/api/chat";
+  private model = process.env.OSS_MODEL ?? "qwen3:4b-instruct";
+
+  async decide(state: TradeState): Promise<Decision> {
+    const t0 = performance.now();
+    const q = QUESTIONS.direction;
+    const system = [
+      "You are a trading decision function. You output exactly one word: buy or sell.",
+      `Goal: ${q.instructions.goal}`,
+      `Timing: ${q.instructions.timing}`,
+      `Inputs: ${q.instructions.inputs}`,
+    ].join("\n");
+    const user = [
+      `State (JSON):\n${JSON.stringify(state)}`,
+      `Question: ${q.instructions.question.replace("`horizonBlocks`", String(state.horizonBlocks))}`,
+      `buy: ${q.criteria.buy}`,
+      `sell: ${q.criteria.sell}`,
+      "Answer with exactly one word: buy or sell.",
+    ].join("\n\n");
+    const res = await fetch(this.url, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        model: this.model, stream: false, keep_alive: -1,
+        messages: [{ role: "system", content: system }, { role: "user", content: user }],
+        logprobs: true, top_logprobs: 20,
+        options: { num_predict: 1, temperature: 0 },
+      }),
+    });
+    const d: any = await res.json();
+    // Sum the probability mass of every surface form of each candidate ("buy", " Buy", "BUY", ...).
+    let pb = 0, ps = 0;
+    for (const c of d.logprobs?.[0]?.top_logprobs ?? []) {
+      const w = String(c.token).trim().toLowerCase(), pr = Math.exp(c.logprob);
+      if (w === "buy") pb += pr; else if (w === "sell") ps += pr;
+    }
+    const buy = pb + ps > 0 ? pb / (pb + ps) : 0.5;
+    return {
+      action: buy >= 0.5 ? "buy" : "sell",
+      probabilities: { buy, sell: 1 - buy, hold: 0 },
+      upIn10: buy,
+      latencyMs: performance.now() - t0,
+      inputTokens: d.prompt_eval_count ?? 0,
+    };
+  }
+}
+
+export const createModel = (): Model =>
+  config.model === "jev" ? new JevModel() : config.model === "oss" ? new OssModel() : new MockModel();
