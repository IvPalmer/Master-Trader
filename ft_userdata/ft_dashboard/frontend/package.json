    "@fontsource/inter": "^5.2.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "alpinejs": "3.14.3",
    "esbuild": "0.25.10",
    "playwright": "1.55.1",
    "typescript": "5.9.2"
  }
}
