      "pair": "{pair}",
      "reason": "{reason}",
      "bot_name": "KeltnerBounceV1"
    },
    "webhookentryfill": {
      "type": "entry_fill",
      "pair": "{pair}",
      "stake_amount": "{stake_amount}",
      "stake_currency": "{stake_currency}",
      "open_rate": "{open_rate}",
      "order_type": "{order_type}",
      "direction": "{direction}",
      "leverage": "{leverage}",
      "bot_name": "KeltnerBounceV1"
    },
    "webhookexit": {
