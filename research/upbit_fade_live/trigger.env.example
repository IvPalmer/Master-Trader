# Template for ~/.config/upbit-fade-live/trigger.env (chmod 600). Never commit the real file.
# The bot's REST API, loopback only (compose publishes ft-upbit-fade-hl on 127.0.0.1:8105).
FT_API_URL=http://127.0.0.1:8105
# The bot's own API credentials: the values ft-upbit-fade-hl started with, read with
#   sudo docker exec ft-upbit-fade-hl printenv FREQTRADE__API_SERVER__USERNAME
#   sudo docker exec ft-upbit-fade-hl printenv FREQTRADE__API_SERVER__PASSWORD
FT_API_USER=
FT_API_PASS=
# Optional ops alerts through trade-webhook (loopback). Empty NOTIFY_URL = no alerts.
NOTIFY_URL=http://127.0.0.1:8088/test/notify
TRADE_WEBHOOK_NOTIFY_TOKEN=
